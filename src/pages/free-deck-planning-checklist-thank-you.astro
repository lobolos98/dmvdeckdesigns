---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Your Free Deck Planning Checklist | DMV Deck Designs"
  description="Your free Maryland Deck Planning Checklist is ready from DMV Deck Designs."
>
  <div class="thanks-page">
    <section class="thanks-hero no-print">
      <p class="eyebrow">YOU'RE IN</p>
      <h1>Your Free Deck Planning Checklist Is Ready.</h1>
      <p>Use this practical checklist to organize your project before requesting professional deck plans.</p>
      <button id="printChecklist" class="primary-button" type="button">Print / Save as PDF</button>
      <p class="print-help">When the print window opens, choose <strong>Save as PDF</strong> as the printer.</p>
    </section>

    <section class="checklist-document" id="checklistDocument">
      <header class="document-header">
        <p class="eyebrow">DMV DECK DESIGNS</p>
        <h2>Maryland Deck Planning Checklist</h2>
        <p>Use this worksheet to organize the information you'll want before moving forward with professional deck design.</p>
      </header>

      <section class="check-section">
        <h3>1. Property & Existing Conditions</h3>
        <label><input type="checkbox" /> Project address confirmed</label>
        <label><input type="checkbox" /> Property survey or plat located</label>
        <label><input type="checkbox" /> Existing deck / structure photos taken</label>
        <label><input type="checkbox" /> House exterior and deck connection photographed</label>
        <label><input type="checkbox" /> Property lines and approximate setbacks identified</label>
        <label><input type="checkbox" /> Existing utilities, trees, slopes, or obstacles noted</label>
      </section>

      <section class="check-section">
        <h3>2. Project Goals</h3>
        <label><input type="checkbox" /> Primary use identified: dining, entertaining, relaxing, etc.</label>
        <label><input type="checkbox" /> Preferred deck location identified</label>
        <label><input type="checkbox" /> Approximate deck size considered</label>
        <label><input type="checkbox" /> Desired shape or layout considered</label>
        <label><input type="checkbox" /> Stairs and access points considered</label>
        <label><input type="checkbox" /> Railings, privacy, lighting, or other features considered</label>
      </section>

      <section class="check-section">
        <h3>3. Materials & Style</h3>
        <label><input type="checkbox" /> Wood or composite preference considered</label>
        <label><input type="checkbox" /> Color and finish preferences noted</label>
        <label><input type="checkbox" /> House style and exterior materials considered</label>
        <label><input type="checkbox" /> Photos or examples of preferred designs collected</label>
      </section>

      <section class="check-section">
        <h3>4. Documents & Permit Preparation</h3>
        <label><input type="checkbox" /> Survey or site plan available</label>
        <label><input type="checkbox" /> HOA requirements checked, if applicable</label>
        <label><input type="checkbox" /> Local permit jurisdiction identified</label>
        <label><input type="checkbox" /> Existing plans or prior permits gathered, if available</label>
        <label><input type="checkbox" /> Property photos organized</label>
        <label><input type="checkbox" /> Zoning / setback questions identified</label>
      </section>

      <section class="check-section">
        <h3>5. Budget & Priorities</h3>
        <label><input type="checkbox" /> Target project budget established</label>
        <label><input type="checkbox" /> Must-have features separated from nice-to-have features</label>
        <label><input type="checkbox" /> Design / permit costs considered separately from construction</label>
        <label><input type="checkbox" /> Desired project timeline considered</label>
      </section>

      <section class="notes-section">
        <h3>6. Questions & Notes</h3>
        <p>Write down questions you want answered before moving forward.</p>
        <div class="note-lines"></div>
        <div class="note-lines"></div>
        <div class="note-lines"></div>
        <div class="note-lines"></div>
      </section>

      <footer class="document-footer">
        <strong>DMV Deck Designs</strong><br />
        Professional deck design | Maryland | Virginia | Washington DC<br />
        info@dmvdeckdesigns.com
      </footer>
    </section>

    <section class="kit-callout no-print">
      <p class="eyebrow">WANT THE COMPLETE WORKBOOK?</p>
      <h2>Take Your Planning Further</h2>
      <p>The Complete Deck Planning Kit expands this free checklist into a detailed homeowner planning workbook for <strong>$49</strong>.</p>
      <a class="primary-button" href="/deck-planning-kit/">Get the Complete Kit — $49</a>
    </section>

    <section class="professional-next no-print">
      <h2>Ready for Professional Deck Plans?</h2>
      <p>When your project is ready for professional design, DMV Deck Designs can help you move from planning to detailed deck drawings.</p>
      <a class="secondary-button" href="/purchase/">View Professional Design Packages</a>
    </section>
  </div>

  <script is:inline>
    document.getElementById('printChecklist')?.addEventListener('click', () => window.print());
  </script>

  <style>
    .thanks-page { max-width: 950px; margin: 0 auto; padding: 30px 20px 70px; text-align: center; font-family: Roboto, sans-serif; }
    .thanks-hero { padding: 65px 20px 35px; }
    .eyebrow { font-size: .82rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; margin-bottom: 12px; }
    h1, h2, h3 { font-family: Oswald, sans-serif; }
    .thanks-hero h1 { font-size: clamp(2.4rem, 6vw, 4.2rem); line-height: 1.05; margin: 0 0 18px; }
    .thanks-hero p { font-size: 1.15rem; line-height: 1.7; }
    .primary-button, .secondary-button { display: inline-block; border: 0; border-radius: 6px; padding: 14px 24px; font-weight: 700; text-decoration: none; cursor: pointer; font-size: 1rem; }
    .print-help { font-size: .9rem !important; margin-top: 12px; }
    .checklist-document { text-align: left; background: #fff; border: 1px solid #d7d7d7; border-radius: 12px; padding: 42px; box-shadow: 0 4px 20px rgba(0,0,0,.06); }
    .document-header { text-align: center; border-bottom: 2px solid #222; padding-bottom: 22px; margin-bottom: 28px; }
    .document-header h2 { font-size: 2.6rem; margin: 0 0 8px; }
    .document-header p:last-child { line-height: 1.6; }
    .check-section { margin: 0 0 26px; break-inside: avoid; }
    .check-section h3, .notes-section h3 { font-size: 1.35rem; margin: 0 0 12px; border-bottom: 1px solid #bbb; padding-bottom: 7px; }
    .check-section label { display: block; padding: 6px 0; line-height: 1.45; }
    input[type="checkbox"] { width: 17px; height: 17px; margin-right: 9px; vertical-align: -3px; }
    .notes-section { margin-top: 28px; break-inside: avoid; }
    .notes-section p { margin-bottom: 14px; }
    .note-lines { border-bottom: 1px solid #999; height: 30px; }
    .document-footer { text-align: center; margin-top: 32px; padding-top: 18px; border-top: 1px solid #bbb; font-size: .85rem; line-height: 1.6; }
    .kit-callout, .professional-next { padding: 35px 25px; border-radius: 12px; margin: 25px 0; }
    .kit-callout h2, .professional-next h2 { margin-top: 0; font-size: 2rem; }
    .kit-callout p, .professional-next p { line-height: 1.65; }
    @media (max-width: 700px) { .checklist-document { padding: 25px 18px; } .document-header h2 { font-size: 2rem; } }
    @media print {
      @page { size: Letter; margin: .55in; }
      body { background: #fff !important; }
      .no-print, header, footer, .chatbot { display: none !important; }
      .thanks-page { max-width: none; margin: 0; padding: 0; }
      .checklist-document { border: 0; box-shadow: none; padding: 0; }
      .check-section { break-inside: avoid; }
    }
  </style>
</BaseLayout>

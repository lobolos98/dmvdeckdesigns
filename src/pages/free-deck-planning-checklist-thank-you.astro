---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Your Free Deck Planning Checklist | DMV Deck Designs"
  description="Your free Maryland Deck Planning Checklist is ready from DMV Deck Designs."
>
  <div class="thanks-page">
    <section class="thanks-hero">
      <p class="eyebrow">YOU'RE IN</p>
      <h1>Your Free Deck Planning Checklist Is Ready.</h1>
      <p>Use this checklist to organize your project before you request professional deck plans.</p>
      <button id="downloadChecklist" class="primary-button" type="button">Download My Free PDF Checklist</button>
      <p id="downloadStatus" class="status" aria-live="polite"></p>
    </section>

    <section class="preview-card">
      <h2>What's Inside</h2>
      <ul>
        <li>Property and existing-condition information</li>
        <li>Project goals and deck-use planning</li>
        <li>Measurements, photos, surveys, and documents</li>
        <li>Permit and HOA preparation reminders</li>
        <li>Budget and next-step planning</li>
      </ul>
    </section>

    <section class="kit-callout">
      <p class="eyebrow">WANT THE COMPLETE WORKBOOK?</p>
      <h2>Take Your Planning Further</h2>
      <p>The Complete Deck Planning Kit expands the free checklist into a more detailed homeowner planning workbook for <strong>$49</strong>.</p>
      <a class="primary-button" href="/deck-planning-kit/">Get the Complete Kit — $49</a>
    </section>

    <section class="professional-next">
      <h2>Ready for Professional Deck Plans?</h2>
      <p>When your project is ready for professional design, DMV Deck Designs can help you move from planning to detailed deck drawings.</p>
      <a class="secondary-button" href="/purchase/">View Professional Design Packages</a>
    </section>
  </div>

  <script is:inline>
    const button = document.getElementById('downloadChecklist');
    const status = document.getElementById('downloadStatus');

    function pdfEscape(value) {
      return value.replace(/\\/g, '\\\\').replace(/\(/g, '\\(').replace(/\)/g, '\\)');
    }

    function makePdf() {
      const page1 = [
        ['Maryland Deck Planning Checklist', 18],
        ['DMV Deck Designs | Free Homeowner Resource', 11],
        ['', 10],
        ['PROPERTY + EXISTING CONDITIONS', 14],
        ['[ ] Project address confirmed', 11],
        ['[ ] Property survey or plat located', 11],
        ['[ ] Existing deck or structure photos taken', 11],
        ['[ ] House exterior and connection point photographed', 11],
        ['[ ] Property lines and setbacks identified', 11],
        ['[ ] Existing utilities or obstacles noted', 11],
        ['', 10],
        ['PROJECT GOALS', 14],
        ['[ ] Primary use identified: dining, entertaining, relaxing, etc.', 11],
        ['[ ] Desired deck location identified', 11],
        ['[ ] Preferred deck shape and approximate size considered', 11],
        ['[ ] Stairs and access points considered', 11],
        ['[ ] Railings, privacy, lighting, or other features considered', 11],
        ['', 10],
        ['MATERIAL + STYLE', 14],
        ['[ ] Wood or composite preference considered', 11],
        ['[ ] Color and finish preferences noted', 11],
        ['[ ] House style and existing exterior considered', 11],
      ];

      const page2 = [
        ['Maryland Deck Planning Checklist - Page 2', 16],
        ['', 10],
        ['DOCUMENTS + PERMIT PREPARATION', 14],
        ['[ ] Survey or site plan available', 11],
        ['[ ] HOA requirements checked, if applicable', 11],
        ['[ ] Local permit jurisdiction identified', 11],
        ['[ ] Existing plans or prior permits gathered, if available', 11],
        ['[ ] Property photos organized', 11],
        ['[ ] Relevant zoning or setback questions identified', 11],
        ['', 10],
        ['BUDGET + PRIORITIES', 14],
        ['[ ] Target project budget established', 11],
        ['[ ] Must-have features separated from nice-to-have features', 11],
        ['[ ] Design and permit costs considered separately from construction', 11],
        ['[ ] Timeline or target completion date considered', 11],
        ['', 10],
        ['NEXT STEP', 14],
        ['Write down the questions you want answered before moving forward.', 11],
        ['', 8],
        ['Notes:', 12],
        ['____________________________________________________________', 10],
        ['____________________________________________________________', 10],
        ['____________________________________________________________', 10],
        ['____________________________________________________________', 10],
        ['', 8],
        ['DMV Deck Designs', 12],
        ['Professional deck design | Maryland | Virginia | Washington DC', 10],
        ['info@dmvdeckdesigns.com', 10],
      ];

      const pages = [page1, page2];
      const objects = [];
      objects.push('<< /Type /Catalog /Pages 2 0 R >>');
      objects.push('<< /Type /Pages /Kids [3 0 R 4 0 R] /Count 2 >>');
      objects.push('<< /Type /Page /Parent 2 0 R /MediaBox [0 0 612 792] /Resources << /Font << /F1 5 0 R >> >> /Contents 6 0 R >>');
      objects.push('<< /Type /Page /Parent 2 0 R /MediaBox [0 0 612 792] /Resources << /Font << /F1 5 0 R >> >> /Contents 7 0 R >>');
      objects.push('<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>');

      function stream(lines) {
        let y = 748;
        let out = 'BT\n';
        for (const [text, size] of lines) {
          if (text === '') { y -= 12; continue; }
          out += `/F1 ${size} Tf\n72 ${y} Td\n(${pdfEscape(text)}) Tj\n0 -${size + 9} Td\n`;
          y -= (size + 9);
        }
        out += 'ET';
        return out;
      }

      objects.push(`<< /Length ${stream(pages[0]).length} >>\nstream\n${stream(pages[0])}\nendstream`);
      objects.push(`<< /Length ${stream(pages[1]).length} >>\nstream\n${stream(pages[1])}\nendstream`);

      let pdf = '%PDF-1.4\n';
      const offsets = [0];
      objects.forEach((obj, i) => {
        offsets.push(pdf.length);
        pdf += `${i + 1} 0 obj\n${obj}\nendobj\n`;
      });
      const xref = pdf.length;
      pdf += `xref\n0 ${objects.length + 1}\n0000000000 65535 f \n`;
      for (let i = 1; i < offsets.length; i++) pdf += `${String(offsets[i]).padStart(10, '0')} 00000 n \n`;
      pdf += `trailer\n<< /Size ${objects.length + 1} /Root 1 0 R >>\nstartxref\n${xref}\n%%EOF`;
      return new Blob([pdf], { type: 'application/pdf' });
    }

    button?.addEventListener('click', () => {
      const blob = makePdf();
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.download = 'DMV-Deck-Planning-Checklist.pdf';
      document.body.appendChild(link);
      link.click();
      link.remove();
      setTimeout(() => URL.revokeObjectURL(url), 1000);
      if (status) status.textContent = 'Your PDF download has started.';
    });
  </script>

  <style>
    .thanks-page { max-width: 950px; margin: 0 auto; padding: 30px 20px 70px; text-align: center; font-family: Roboto, sans-serif; }
    .thanks-hero { padding: 70px 20px 45px; }
    .eyebrow { font-size: .82rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; margin-bottom: 12px; }
    h1, h2 { font-family: Oswald, sans-serif; }
    .thanks-hero h1 { font-size: clamp(2.4rem, 6vw, 4.2rem); line-height: 1.05; margin: 0 0 18px; }
    .thanks-hero p { font-size: 1.15rem; line-height: 1.7; }
    .primary-button, .secondary-button { display: inline-block; border: 0; border-radius: 6px; padding: 14px 24px; font-weight: 700; text-decoration: none; cursor: pointer; font-size: 1rem; }
    .status { min-height: 1.2em; font-size: .9rem !important; }
    .preview-card, .kit-callout, .professional-next { padding: 35px 25px; border-radius: 12px; margin: 20px 0; }
    .preview-card { text-align: left; }
    .preview-card h2 { text-align: center; }
    .preview-card li { margin: 12px 0; line-height: 1.5; }
    .kit-callout h2, .professional-next h2 { margin-top: 0; font-size: 2rem; }
    .kit-callout p, .professional-next p { line-height: 1.65; }
  </style>
</BaseLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Thank You | DMV Deck Designs"
  description="Thank you for purchasing the DMV Deck Designs Complete Deck Planning Kit."
>
  <section class="success-page">
    <div class="success-icon">✓</div>
    <h1>Thank You for Your Purchase!</h1>
    <h2>Your Deck Planning Kit Is Ready</h2>
    <p>
      Your payment was completed successfully. Your secure download is available below.
    </p>

    <div class="delivery-box">
      <h3>Download Your Kit</h3>
      <p>
        Click the button below to securely retrieve your Deck Planning Kit. Your download
        is verified through Stripe before the private PDF is delivered from Cloudflare R2.
      </p>
      <a id="download-kit" class="button download-button" href="#">Download My Deck Planning Kit</a>
      <p id="download-error" class="error" hidden>
        We could not verify the payment session. Please return to your Stripe confirmation
        page or contact DMV Deck Designs at
        <a href="mailto:info@dmvdeckdesigns.com">info@dmvdeckdesigns.com</a>.
      </p>
    </div>

    <div class="success-actions">
      <a class="button secondary" href="/purchase/">View Professional Design Packages</a>
      <a class="button secondary" href="/">Return to DMV Deck Designs</a>
    </div>
  </section>

  <script>
    const params = new URLSearchParams(window.location.search);
    const sessionId = params.get("session_id");
    const downloadButton = document.getElementById("download-kit");
    const errorMessage = document.getElementById("download-error");

    if (sessionId && downloadButton) {
      downloadButton.href = `/api/download-kit?session_id=${encodeURIComponent(sessionId)}`;
    } else {
      downloadButton?.setAttribute("aria-disabled", "true");
      downloadButton?.classList.add("disabled");
      if (errorMessage) errorMessage.hidden = false;
    }
  </script>

  <style>
    .success-page {
      max-width: 850px;
      margin: 0 auto;
      padding: 75px 25px 90px;
      text-align: center;
    }

    .success-icon {
      width: 80px;
      height: 80px;
      margin: 0 auto 25px;
      border-radius: 50%;
      background: #1b365d;
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 46px;
      font-weight: 700;
    }

    .success-page h1 {
      font-size: clamp(40px, 6vw, 58px);
    }

    .success-page h2 {
      color: #1b365d;
    }

    .success-page > p {
      max-width: 700px;
      margin: 20px auto;
      font-size: 18px;
    }

    .delivery-box {
      max-width: 650px;
      margin: 40px auto;
      padding: 30px;
      background: #f5f7fa;
      border-radius: 12px;
      border: 1px solid #ddd;
    }

    .delivery-box h3 {
      color: #1b365d;
    }

    .download-button {
      display: inline-block;
      margin: 12px 0 8px;
      text-decoration: none;
    }

    .disabled {
      opacity: .55;
      pointer-events: none;
    }

    .error {
      color: #b22234;
      font-size: 14px;
    }

    .note {
      font-size: 15px;
    }

    .success-actions {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 10px;
    }
  </style>
</BaseLayout>

<script>


/******************************************
DATE + AGREEMENT NUMBER
******************************************/

const today = new Date();


const formattedDate =
today.toISOString().split("T")[0];



// Agreement Start Date

document.getElementById("agreementDate").value =
formattedDate;



// Client Signature Date

document.getElementById("clientDate").value =
formattedDate;




// DMV Deck Designs Representative Date

document.getElementById("companyDate").textContent =
today.toLocaleDateString();




// Generate Agreement Number

const agreementNumber =
"DMV-" +
today.getFullYear() +
"-" +
Math.floor(
100000 + Math.random() * 900000
);



document.getElementById(
"agreementNumber"
).value = agreementNumber;



document.getElementById(
"displayAgreementNumber"
).textContent = agreementNumber;



document.getElementById(
"displayDate"
).textContent =
today.toLocaleDateString();








/******************************************
PACKAGE TOTAL CALCULATION
******************************************/

const packages =
document.querySelectorAll(
'input[name="package"]'
);



const consultation =
document.getElementById(
"consultation"
);



const paymentAmount =
document.getElementById(
"paymentAmount"
);



const finalPayment =
document.getElementById(
"finalPaymentAmount"
);





function updateTotal(){


let total = 0;


let selected = false;



packages.forEach(function(item){


if(item.checked){


selected = true;


total += Number(item.value);


}


});





if(selected){


consultation.disabled = false;


}

else{


consultation.disabled = true;


consultation.checked = false;


}






if(consultation.checked){


total += 250;


}





let formatted =

"$" + total.toFixed(2);



paymentAmount.value = formatted;


finalPayment.value = formatted;



}






packages.forEach(function(item){


item.addEventListener(
"change",
updateTotal
);


});





consultation.addEventListener(
"change",
updateTotal
);



updateTotal();








/******************************************
DIGITAL SIGNATURE PAD
******************************************/

const canvas =
document.getElementById(
"signaturePad"
);



const ctx =
canvas.getContext(
"2d"
);



ctx.lineWidth = 2;

ctx.lineCap = "round";



let drawing = false;




function getPosition(e){


const rect =
canvas.getBoundingClientRect();



if(e.touches){


return {


x:
e.touches[0].clientX - rect.left,


y:
e.touches[0].clientY - rect.top


};


}



return {


x:e.clientX - rect.left,


y:e.clientY - rect.top


};


}






function startDrawing(e){


drawing = true;


const pos =
getPosition(e);


ctx.beginPath();


ctx.moveTo(
pos.x,
pos.y
);


}





function draw(e){


if(!drawing)
return;


e.preventDefault();



const pos =
getPosition(e);



ctx.lineTo(
pos.x,
pos.y
);



ctx.stroke();



}






function stopDrawing(){


drawing=false;


}





canvas.addEventListener(
"mousedown",
startDrawing
);



canvas.addEventListener(
"mousemove",
draw
);



canvas.addEventListener(
"mouseup",
stopDrawing
);



canvas.addEventListener(
"mouseleave",
stopDrawing
);





canvas.addEventListener(
"touchstart",
startDrawing
);



canvas.addEventListener(
"touchmove",
draw
);



canvas.addEventListener(
"touchend",
stopDrawing
);







function clearSignature(){


ctx.clearRect(
0,
0,
canvas.width,
canvas.height
);


}







/******************************************
CHECK SIGNATURE EXISTS
******************************************/

function signatureComplete(){


const pixels =
ctx.getImageData(
0,
0,
canvas.width,
canvas.height
).data;



for(
let i = 3;
i < pixels.length;
i += 4
){


if(pixels[i] > 0){


return true;


}


}



return false;


}







/******************************************
STRIPE PAYMENT LINKS
******************************************/


const stripeLinks = {


standard:

"https://buy.stripe.com/7sY7sMe6F1W549PbcQ3Nm01",



standardConsult:

"https://buy.stripe.com/fZu8wQd2B3096hXcgU3Nm03",



premium:

"https://buy.stripe.com/28EbJ23s11W56hX1Cg3Nm00",



premiumConsult:

"https://buy.stripe.com/8x2cN67IhbwFbCh4Os3Nm04"



};







/******************************************
FORM SUBMISSION
******************************************/

document

.getElementById(
"agreementForm"
)

.addEventListener(

"submit",

function(e){


e.preventDefault();






if(finalPayment.value === "$0.00"){


alert(
"Please select a design package."
);


return;


}






if(!signatureComplete()){


alert(
"Please provide your digital signature."
);


return;


}






document.getElementById(
"signedTimestamp"
).value =
new Date().toISOString();







let selectedPackage =

document.querySelector(
'input[name="package"]:checked'
);






let paymentURL = "";







if(
selectedPackage.value === "499"
&&
!consultation.checked
){


paymentURL =
stripeLinks.standard;


}







if(
selectedPackage.value === "499"
&&
consultation.checked
){


paymentURL =
stripeLinks.standardConsult;


}







if(
selectedPackage.value === "999"
&&
!consultation.checked
){


paymentURL =
stripeLinks.premium;


}







if(
selectedPackage.value === "999"
&&
consultation.checked
){


paymentURL =
stripeLinks.premiumConsult;


}






/*

PDF GENERATION HOOK

This is where a PDF/email service
will be connected.

The form data includes:

- Client Name
- Client Email
- Agreement Number
- Signature
- Package
- Amount
- Date

*/






// Redirect to Stripe

window.location.href =
paymentURL;



}

);



</script>






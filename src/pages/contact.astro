<BaseLayout

title="Start Your Project | DMV Deck Designs"

description="Book your professional deck design consultation with DMV Deck Designs. We review your goals, property conditions, design ideas, and recommend the best approach for your custom deck project."

>


<main class="contact-page">






<section class="page-hero">


<h1>
START YOUR PROJECT
</h1>


<h2>
Book Your Professional Design Consultation
</h2>



<p>
Every successful outdoor living project begins with a thoughtful plan. During your consultation, we will review your goals, property conditions, design ideas, and recommend the best approach for your custom deck project.
</p>


</section>









<section class="consultation-layout">







<div class="consultation-box">


<h2>
Design Consultation
</h2>


<h3>
$250
</h3>



<p>
Professional guidance to help move your deck project forward with confidence.
</p>




<ul>

<li>
Review of project goals
</li>


<li>
Deck design ideas and layout options
</li>


<li>
Site and property considerations
</li>


<li>
Material recommendations
</li>


<li>
Design and permitting guidance
</li>


<li>
Next-step project planning
</li>


</ul>



</div>









<div class="contact-info">


<h2>
Contact Information
</h2>



<p>
<strong>
Phone:
</strong>
<br>
(888) 733-3837
</p>



<p>
<strong>
Email:
</strong>
<br>
info@dmvdeckdesigns.com
</p>



<p>
<strong>
Service Area:
</strong>
<br>
Maryland • Northern Virginia • Washington DC
</p>



<p>
<strong>
Availability:
</strong>
<br>
Consultations By Appointment Only
</p>



</div>






</section>









<form

class="contact-form"

action="https://formsubmit.co/info@dmvdeckdesigns.com"

method="POST"

enctype="multipart/form-data"

>





<input
type="hidden"
name="_subject"
value="New DMV Deck Designs Consultation Request"
/>



<input
type="hidden"
name="_template"
value="table"
/>





<h2>
Request Your Consultation
</h2>







<input

type="text"

name="Name"

placeholder="Your Name"

required

>




<input

type="email"

name="Email"

placeholder="Email Address"

required

>





<input

type="tel"

name="Phone"

placeholder="Phone Number"

required

>







<input

type="text"

name="Project Address"

placeholder="Project Address"

required

>






<input

type="text"

name="Project City County"

placeholder="Project City / County"

required

>









<select

name="Project Type"

required

>

<option value="">
Select Project Type
</option>

<option>
New Deck
</option>

<option>
Replace Existing Deck
</option>

<option>
Expand Existing Deck
</option>

</select>









<select

name="Deck Material"

>

<option value="">
Select Deck Material
</option>


<option>
Wood
</option>


<option>
Composite / Trex
</option>


<option>
Not Sure
</option>


</select>









<label>
Project Features
</label>


<label class="checkbox-option">

<input

type="checkbox"

name="Features"

value="Stairs"

>

Stairs

</label>




<label class="checkbox-option">

<input

type="checkbox"

name="Features"

value="Lighting"

>

Lighting

</label>









<label>
HOA Approval Required?
</label>



<select name="HOA">

<option>
Select Option
</option>


<option>
Yes
</option>


<option>
No
</option>


<option>
Not Sure
</option>


</select>








<label>
Project Details
</label>



<textarea

name="Project Details"

rows="8"

placeholder="Tell us about your deck project"

></textarea>









<label>
Upload Property Photos
</label>


<input

type="file"

name="Property Photos"

multiple

>









<label>
Upload Plans, Surveys, HOA Documents, or Existing Drawings
</label>


<input

type="file"

name="Project Documents"

multiple

>









<button

class="button"

type="submit"

>

Request My Consultation

</button>



</form>









<section class="payment-box">


<h2>
Ready To Begin?
</h2>



<p>
Complete your consultation payment to reserve your design appointment.
</p>




<a

href="https://buy.stripe.com/8x2cN63s1cAJcGlep23Nm02"

class="button"

>

Pay $250 Consultation Fee

</a>




<p>
Upload property photos, surveys, HOA requirements, or existing drawings to help us better understand your deck project.
</p>



</section>









<script>


const planner =

localStorage.getItem(
"dmvDeckPlanner"
);



if(planner){


const data =
JSON.parse(planner);



const details =

document.querySelector(
'textarea[name="Project Details"]'
);



if(details){


details.value =

`
PROJECT PLANNER SUMMARY

Location:
${data.location}

Project Type:
${data.project}

Material:
${data.material}

Features:
${data.features}

HOA Approval:
${data.hoa}

Timeline:
${data.timeline}

`;

}



}



</script>








</main>


</BaseLayout>
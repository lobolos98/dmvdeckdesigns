---
import "../styles/global.css";

import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Chatbot from "../components/Chatbot.astro";


const {

title = "DMV Deck Designs | Professional Deck Plans",

description = "Professional deck design services including CAD drawings, permit-ready deck plans, custom deck designs, and certified structural drawings throughout Maryland, Virginia, and Washington DC.",

image = "/logo.png"

} = Astro.props;



const canonicalURL = new URL(
Astro.url.pathname,
Astro.site
);

const siteURL = "https://dmvdeckdesigns.com";

---


<!doctype html>

<html lang="en">


<head>


<meta charset="UTF-8" />


<meta
name="viewport"
content="width=device-width, initial-scale=1.0"
/>



<title>
{title}
</title>



<meta
name="description"
content={description}
/>



<link
rel="canonical"
href={canonicalURL}
/>





<!-- =========================
OPEN GRAPH
========================= -->


<meta
property="og:type"
content="website"
/>


<meta
property="og:title"
content={title}
/>


<meta
property="og:description"
content={description}
/>


<meta
property="og:image"
content={`${siteURL}${image}`}
/>


<meta
property="og:url"
content={canonicalURL}
/>





<!-- =========================
TWITTER
========================= -->


<meta
name="twitter:card"
content="summary_large_image"
/>


<meta
name="twitter:title"
content={title}
/>


<meta
name="twitter:description"
content={description}
/>


<meta
name="twitter:image"
content={`${siteURL}${image}`}
/>





<!-- =========================
GLOBAL SEO SCHEMA
========================= -->


<script type="application/ld+json">
{
 "@context":"https://schema.org",
 "@graph":[

 {
  "@type":"Organization",
  "@id":"https://dmvdeckdesigns.com/#organization",
  "name":"DMV Deck Designs",
  "url":"https://dmvdeckdesigns.com",
  "logo":{
    "@type":"ImageObject",
    "url":"https://dmvdeckdesigns.com/logo.png"
  }
 },


 {
  "@type":"LocalBusiness",
  "@id":"https://dmvdeckdesigns.com/#business",
  "name":"DMV Deck Designs",
  "url":"https://dmvdeckdesigns.com",
  "logo":"https://dmvdeckdesigns.com/logo.png",
  "description":"Professional deck design services including CAD drawings, permit-ready deck plans, custom deck designs, and certified structural drawings.",
  
  "areaServed":[
   {
    "@type":"State",
    "name":"Maryland"
   },
   {
    "@type":"State",
    "name":"Virginia"
   },
   {
    "@type":"City",
    "name":"Washington DC"
   }
  ],

  "serviceType":[
   "Deck Design",
   "CAD Drawings",
   "Permit Ready Deck Plans",
   "Certified Structural Drawings"
  ],

  "sameAs":[
   "https://www.facebook.com/",
   "https://www.instagram.com/"
  ]
 },


 {
  "@type":"WebSite",
  "@id":"https://dmvdeckdesigns.com/#website",
  "url":"https://dmvdeckdesigns.com",
  "name":"DMV Deck Designs",
  "publisher":{
   "@id":"https://dmvdeckdesigns.com/#organization"
  }
 }

 ]
}
</script>





<!-- =========================
FONTS
========================= -->


<link
rel="preconnect"
href="https://fonts.googleapis.com"
/>


<link
rel="preconnect"
href="https://fonts.gstatic.com"
crossorigin
/>


<link
href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;600;700&family=Roboto:wght@300;400;500;700&display=swap"
rel="stylesheet"
/>


</head>




<body>


<Header />


<main>

<slot />

</main>



<Footer />


<Chatbot />


</body>


</html>
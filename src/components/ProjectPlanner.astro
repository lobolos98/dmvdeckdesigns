<script>


let currentStep = 0;


const steps = document.querySelectorAll(".planner-step");


const progress = document.getElementById("progress-fill");


const stepText = document.getElementById("step-text");


const next = document.getElementById("next");


const previous = document.getElementById("previous");





function updatePlanner(){


steps.forEach((step,index)=>{


step.classList.toggle(
"active",
index === currentStep
);


});



let percent =
(currentStep / (steps.length - 1)) * 100;



progress.style.width =
percent + "%";



stepText.textContent =
`Step ${currentStep + 1} of ${steps.length}`;



previous.style.display =
currentStep === 0
? "none"
: "block";



next.textContent =
currentStep === steps.length - 1
? "View Summary"
: "Next";


}







next.addEventListener("click",()=>{


if(currentStep < steps.length - 1){


currentStep++;


updatePlanner();


}

else{


generateSummary();


}


});







previous.addEventListener("click",()=>{


if(currentStep > 0){


currentStep--;


updatePlanner();


}


});








function generateSummary(){



let features=[];



document
.querySelectorAll('input[name="features"]:checked')
.forEach(item=>{


features.push(item.value);


});





let projectData={


location:
document.querySelector('input[name="location"]:checked')?.value || "",


project:
document.querySelector('input[name="projectType"]:checked')?.value || "",


material:
document.querySelector('input[name="material"]:checked')?.value || "",


features:
features.join(", ") || "None",


hoa:
document.querySelector('input[name="hoa"]:checked')?.value || "",


timeline:
document.querySelector('input[name="timeline"]:checked')?.value || ""



};






document.getElementById("summary").innerHTML = `


<strong>Location:</strong>
${projectData.location}

<br><br>

<strong>Project Type:</strong>
${projectData.project}

<br><br>

<strong>Material:</strong>
${projectData.material}

<br><br>

<strong>Features:</strong>
${projectData.features}

<br><br>

<strong>HOA:</strong>
${projectData.hoa}

<br><br>

<strong>Timeline:</strong>
${projectData.timeline}


`;





let packageRecommendation =
"Standard Package - $499";



if(

projectData.location === "Washington DC" ||

projectData.hoa === "Yes" ||

projectData.project === "Expand Existing Deck"

){


packageRecommendation =
"Premium Package - $999";


}





document.getElementById("recommendation").innerHTML = `


<h3>
Recommended Package
</h3>


<p>
<strong>
${packageRecommendation}
</strong>
</p>


<p>
Professional CAD drawings, permit-ready plans, and expert design support.
</p>


`;



}



updatePlanner();


</script>
gap:20px;

margin-top:30px;


}




.slider img {


width:750px;

max-width:85%;

height:500px;

object-fit:contain;

border:1px solid #ddd;

border-radius:10px;

background:white;


}





.gallery-button {


width:45px;

height:45px;

border:none;

border-radius:50%;

background:#1b365d;

color:white;

font-size:25px;

cursor:pointer;


}




.gallery-button:hover {


background:#c8102e;


}





.gallery-label {


margin-top:20px;

font-size:20px;

font-weight:bold;


}






@media(max-width:700px){


.slider img {


height:300px;


}


.gallery-button {


width:38px;

height:38px;

font-size:20px;


}



}



</style>
<header class="site-header">

  <div class="nav-container">

    <div class="logo-container">
      <a href="/" aria-label="DMV Deck Designs Home">
        <img src="/logo.png" alt="DMV Deck Designs Logo" class="site-logo" />
      </a>
    </div>

    <nav class="desktop-nav">
      <a href="/">Home</a>
      <a href="/services/">Services</a>
      <a href="/process/">Design Process</a>

      <div class="dropdown">
        <button class="drop-button" type="button">Locations ▼</button>
        <div class="dropdown-menu">
          <a href="/locations/">All Locations</a>
          <a href="/deck-design-maryland/">Maryland</a>
          <a href="/deck-design-virginia/">Virginia</a>
          <a href="/deck-design-washington-dc/">Washington DC</a>
        </div>
      </div>

      <a href="/project-planner/">Project Planner</a>
      <a href="/free-deck-planning-checklist/">Free Checklist</a>
      <a href="/deck-planning-kit/">Deck Planning Kit</a>

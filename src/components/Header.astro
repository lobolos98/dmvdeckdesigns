      <a href="/faq/">FAQ</a>

      <a href="/contact/" class="consult-button">📅 Book Consultation</a>
    </nav>

    <button class="mobile-toggle" aria-label="Open Menu" type="button">☰</button>
  </div>

  <nav class="mobile-nav">
    <a href="/">Home</a>
    <a href="/services/">Services</a>
    <a href="/process/">Design Process</a>
    <a href="/locations/">Locations</a>
    <a href="/project-planner/">Project Planner</a>
